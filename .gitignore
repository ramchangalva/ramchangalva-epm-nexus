# EPM password files (never commit credentials)
config/passwords/*
!config/passwords/.gitkeep
*.epw

# Log files
logs/*
!logs/.gitkeep

# Downloaded data / reports
data/output/*
!data/output/.gitkeep
data/input/*
!data/input/.gitkeep

# Snapshot artifacts
scripts/artifacts/*
!scripts/artifacts/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.vscode/settings.json